---
import Layout from "../layouts/Layout.astro";
---

<Layout title="blog | あみーごのホームページ">
	<!-- Works内容 -->
	<div class="profile-text">
		<h1 class="heading-2">BLOG</h1>
		<div class="blog-container">

			<a href="https://note.com/jinauec26/n/n12b6766cd896" target="_blank" rel="nooper noreferrer" class="blog-card">
				<div class="blog-layout">
					<div class="blog-image-wrapper">
						<img src="/images/hanabi.png" class="blog-image">
					</div>
					<div class="blog-text">
						<div class="blog-header">
							<p>2026/9/2</p>
							<h2>『線香花火職人』- 制作記録</h2>
						</div>
					</div>
				</div>
			</a>
				

			<a href="https://note.com/jinauec26/n/nd376f91f64d3" target="_blank" rel="nooper noreferrer" class="blog-card">
				<div class="blog-layout">
					<div class="blog-image-wrapper">
						<img src="/images/blog1.png" class="blog-image">
					</div>
					<div class="blog-text">
						<div class="blog-header">
							<p>2026/9/2</p>
							<h2>あみーごの自己紹介</h2>
						</div>
					</div>
				</div>
			</a>

		</div>
	</div>

	
</Layout>
<style>	
	.profile-text h1 {
		margin: 0; 
		font-size: 2rem;
		font-family: "Dela Gothic One", sans-serif;
		color: #ff007f;
	}
	
	.heading-2 {
		padding:0 .4em 0.001em;    
		border-bottom: 2px solid #ff007f;
		background-color: #ffffff;
		color: #333333;
	}

	.blog-card {
        display: block;
        position: relative;
        z-index: 5;
        margin-top: 10px;
        background-color: #ffffff;
        border-radius: 16px;
        padding: 1rem 0.8rem;
        box-shadow: 0 2px 16px rgba(0, 0, 0, 0.08);
        text-decoration: none;
        color: inherit;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
	    
	.blog-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    }

	.blog-layout {
        display: flex;
        align-items: center;
        gap: 2rem;
    }

	.blog-image-wrapper {
		width: 180px;
		height: 90px;
		flex-shrink: 0;
		border-radius: 12px;
		overflow: hidden;
	}
	    
	.blog-image {
        width: 100%;
		height: 100%;
        object-fit: cover;
    }

	.blog-text {
        display: flex;
        flex-direction: column;
		justify-content: center;
		flex-grow: 1;
        gap: 0.4rem;
    }

	.blog-header h2 {
		margin: 0;
		font-size: 1.25rem;
		color: #333333;
	}

	.blog-header p {
		margin: 0;
		font-size: 0.9rem;
		color: #333333;
	}

	.blog-desc {
		margin: 0;
		font-size: 0.85rem;
		color: #666666;
		line-height: 1.5;
	}

    @media (max-width: 600px) {
        .blog-layout {
            flex-direction: column;
            align-items: flex-start;
        }

        .blog-image-wrapper {
            width: 100%;
            height: 140px;
        }
    }
</style>