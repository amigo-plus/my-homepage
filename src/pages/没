<!-- ミニゲーム -->
	<div class="section-card game-section">
		<p class="game-instruction">MINI GAME</p>
		<div class="game-console-screen">
			<div class="canvas-container">
				<canvas id="MiniGame" width="400" height="250"></canvas>
			    <div id="gameover-screen" class="game-overlay hidden">
				    <p id="gameResultText">GAME OVER</p>
				    <button id="restartBtn" type="button">RETRY</button>
			    </div>
		    </div>
		</div>
		<p class="game-instruction">【操作方法】 左右キー または A / D キーで移動</p>
	</div>

    <script>
	// ゲーム部分
	//const canvas =document.getElementById('MiniGame') as HTMLCanvasElement;
	const ctx = canvas?.getContext('2d');
	const gameOverScreen = document.getElementById('gameover-screen');
	const restartBtn = document.getElementById('restartBtn');
	const gameResultText = document.getElementById('gameResultText')

	if (canvas && ctx) {
		const context = ctx;

		const player = {  // プレイヤー設定
			x: ( canvas.width / 2 ) - 15,
			y: canvas.height - 30,
			width: 30,
			height: 20,
			speed: 5,
			color: '#ff007f'
		};

		// 障害物・ゲーム状態
		//let obstacles: { x: number; y: number; width: number; height: number; speed: number }[] = []; // 上から落ちてくる障害物のデータをしまっておく配列
		let score = 0;
		let isGameOver = false;
		//let animationId: number;
		//const keys: { [key: string]: boolean } = {};

		// キーボード入力の監視
		window.addEventListener('keydown', (e) => (keys[e.key] = true));
		window.addEventListener('keyup', (e) => (keys[e.key] = false));

		// 障害物の生成
		function spawnObstacle() {
			if (isGameOver) return;
			const width = Math.random() * 20 + 15;
			obstacles.push({
				x: Math.random() * (canvas.width - width),
				y: -20,
				width: width,
				height: 15,
				speed: Math.random() * 2 + 2 + score * 0.05 // スコアが上がると少し速くなる
			});
		}
		let spawnInterval = setInterval(spawnObstacle, 600);

		// ゲームメインループ
		function gameLoop() {
			if (isGameOver) return;

			ctx.clearRect(0, 0, canvas.width, canvas.height); // 画面リセット

			// プレイヤー移動処理 (A/D または 左右キー)
			if ((keys['ArrowLeft'] || keys['a'] || keys['A']) && player.x > 0) {
				player.x -= player.speed;
			}
			if ((keys['ArrowRight'] || keys['d'] || keys['D']) && player.x < canvas.width - player.width) {
				player.x += player.speed;
			}

			// プレイヤーの描画
			ctx.fillStyle = player.color;
			ctx.fillRect(player.x, player.y, player.width, player.height);

			// 障害物の更新と描画
			ctx.fillStyle = '#00ccff';
			for (let i = obstacles.length - 1; i >= 0; i--) {
				const obs = obstacles[i];
				obs.y += obs.speed;
				ctx.fillRect(obs.x, obs.y, obs.width, obs.height);

				// 当たり判定
				if (
					player.x < obs.x + obs.width &&
					player.x + player.width > obs.x &&
					player.y < obs.y + obs.height &&
					player.y + player.height > obs.y
				) {
					endGame();
				}

				// 画面外に出たらスコア加算して削除
				if (obs.y > canvas.height) {
					obstacles.splice(i, 1);
					score++;
				}
			}

			// スコア描画
			ctx.fillStyle = '#ffffff';
			ctx.font = 'bold 14px sans-serif';
			ctx.fillText(`SCORE: ${score}`, 10, 20);

			animationId = requestAnimationFrame(gameLoop);
		}

		// ゲームオーバー処理
		function endGame() {
			isGameOver = true;
			clearInterval(spawnInterval); // 障害物の生成を止める
			cancelAnimationFrame(animationId); // アニメーションを止める
			
			if (gameResultText) gameResultText.textContent = `GAME OVER (SCORE: ${score})`;
			gameOverScreen?.classList.remove('hidden');
		}

		// リセット処理
		function resetGame() {
			isGameOver = false;
			score = 0;
			obstacles = [];
			player.x = canvas.width / 2 - 15;
			gameOverScreen?.classList.add('hidden');
			clearInterval(spawnInterval);
			spawnInterval = setInterval(spawnObstacle, 600);
			gameLoop();
		}

		restartBtn?.addEventListener('click', resetGame);

		// ゲーム開始
		gameLoop();
	}
</script>
