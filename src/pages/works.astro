---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Works | あみーごのホームページ">
	<!-- Works内容 -->
	<div class="profile-text">
		   <h1 class="heading-2">WORKS</h1>
		   <ul>
			<li>
				<strong>このホームページ</strong> — Astroで制作
			</li>
		</ul>
	</div>

	
</Layout>
<style>	
	.profile-text h1 {
		margin: 0;       /* 上下の不要な余白を消してスッキリさせる */
		font-size: 2rem;
		font-family: "Dela Gothic One", sans-serif;
		color: #ff007f;
	}
	
	.heading-2 {
		padding:0 .4em 0.001em;    
		border-bottom: 2px solid #ff007f;
		background-color: #ffffff;
		color: #333333;
	}
	


</style>