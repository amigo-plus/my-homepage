---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Works | あみーごのホームページ">
	<!-- Works内容 -->
	<div class="profile-text">
		<h1 class="heading-2">WORKS</h1>
		<div class="work-container">
				
			<a href="https://unityroom.com/games/senkouhanabi_shokuninn" target="_blank" rel="noopener noreferrer" class="work-card">
				<div class="work-layout">
					<div class="work-image-wrapper">
						<img src="/images/hanabi.png" class="work-image">
					</div>
					<div class="work-text">
						<div class="work-header">
							<h2>線香花火職人</h2>
						</div>
						<p class="work-desc">Unityで制作。短いけどちゃんとしたゲームを完成出来て満足。</p>
					</div>
				</div>
			</a>

			<a href="/" class="work-card">
				<div class="work-layout">
					<div class="work-image-wrapper">
						<img src="/images/tatsuya.jpg" class="work-image">
					</div>
					<div class="work-text">
						<div class="work-header">
							<h2>ホームページ</h2>
						</div>
						<p class="work-desc">Astroで制作。随時更新予定！</p>
					</div>
				</div>
			</a>

		</div>
	</div>

	
</Layout>
<style>	
	.profile-text h1 {
		margin: 0; 
		font-size: 2rem;
		font-family: "Dela Gothic One", sans-serif;
		color: #ff007f;
	}
	
	.heading-2 {
		padding:0 .4em 0.001em;    
		border-bottom: 2px solid #ff007f;
		background-color: #ffffff;
		color: #333333;
	}

	.work-card {
        display: block;
        position: relative;
        z-index: 5;
        margin-top: 10px;
        background-color: #ffffff;
        border-radius: 16px;
        padding: 1rem 0.8rem;
        box-shadow: 0 2px 16px rgba(0, 0, 0, 0.08);
        text-decoration: none;
        color: inherit;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
	    
	.work-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    }

	.work-layout {
        display: flex;
        align-items: center;
        gap: 2rem;
    }

	.work-image-wrapper {
		width: 180px;
		height: 90px;
		flex-shrink: 0;
		border-radius: 12px;
		overflow: hidden;
	}
	    
	.work-image {
        width: 100%;
		height: 100%;
        object-fit: cover;
    }

	.work-text {
        display: flex;
        flex-direction: column;
		justify-content: center;
		flex-grow: 1;
        gap: 0.4rem;
    }

	.work-header h2 {
		margin: 0;
		font-size: 1.25rem;
		color: #333333;
	}

	.work-desc {
		margin: 0;
		font-size: 0.85rem;
		color: #666666;
		line-height: 1.5;
	}

    @media (max-width: 600px) {
        .work-layout {
            flex-direction: column;
            align-items: flex-start;
        }

        .work-image-wrapper {
            width: 100%;
            height: 140px;
        }
    }
</style>