---
const { title } = Astro.props;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<link href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&display=swap" rel="stylesheet" />
		<link rel="icon" type="image/png" href="/tatsuya.jpg" />
	</head>
	<body>
		<div id="stickerContainer"></div>
		<header>
			<nav>
				<a href="/" class="site-logo">amigo</a>
				<div class ="nav-links">
					<a href="/">Home</a>
					<a href="/about">About</a>
					<a href="/works">Works</a>
				</div>
			</nav>
		</header>

		<main>
			<slot />
		</main>
		<button id="clearStickersBtn" class="clear-btn">シールをはがす</button>
		<footer>© 2026 amigo</footer>
	</body>
</html>
<script>

	const stickers = [
		"/images/amigo_sticker.png",
		"/images/amigochara_sticker.png",
		"/images/m.png",
		"/images/s.png",
		"/images/star_sticker.png",
		"/images/ice_sticker.png",
		"/images/mini_sticker.png",
		"/images/ink_sticker.png",
	];
	const stickerContainer = document.getElementById('stickerContainer');

	function createSticker(x,y,isBackground = false) {
		if (!stickerContainer) return;

		const sticker = document.createElement('img');
		sticker.classList.add('sticker');
		const randomSticker = stickers[Math.floor(Math.random()*stickers.length)]; // ランダムにシール選出
		sticker.src = randomSticker;

		const rotate = Math.floor(Math.random()*60) -30;　//　シールの傾き
		const scale = (Math.random()*0.4 + 0.8).toFixed(2); // シールの大きさ

		sticker.style.left = `${x}px`;　// 指定された画面の座標（x, y）にシールの位置を設定
        sticker.style.top = `${y}px`;

		sticker.style.transform = `translate(-50%, -50%) rotate(${rotate}deg) scale(${scale})`;
		if (isBackground) {
			sticker.classList.add('bg-sticker');
		}

		stickerContainer.appendChild(sticker);
	}

	window.addEventListener('pointerdown',(e) => { // クリックしたらシール張る
		if (e.target.closest('a,button,input, #gameArea')) return;
		const rect = stickerContainer.getBoundingClientRect();

		const x = e.clientX - rect.left;
		const y = e.clientY - rect.top;

		createSticker(x, y);
	})

	window.addEventListener('DOMContentLoaded', () => {
		const bgStickerCount = 10;

		stickerContainer.style.height = `${document.documentElement.scrollHeight}px`;

		const width = window.innerWidth;
		const height = document.documentElement.scrollHeight;
		for (let i = 0; i < bgStickerCount; i++) {
			const randomX = Math.random()*width;
			const randomY = Math.random()*height;
			createSticker(randomX,randomY, true);
		}
	});

	// 「シールをはがす」ボタンの処理
	const clearBtn = document.getElementById('clearStickersBtn');

	if (clearBtn) {
		clearBtn.addEventListener('click', (e) => {
        // ボタン自体のクリックで新しくシールが貼られないようにイベント伝播をストップ
        e.stopPropagation();
        // .bg-sticker が付いて「いない」クリックで貼ったシールだけを取得
        const userStickers = document.querySelectorAll('.sticker:not(.bg-sticker)');

		userStickers.forEach(sticker => sticker.classList.add('is-fading'));

		setTimeout(() => {
            userStickers.forEach(sticker => sticker.remove());
        }, 300);
    });
}
</script>

<style is:global>
	body {
		max-width: 720px;
		margin: 0 auto;
		padding: 2rem 1.5rem;
		font-family: "Zen Kaku Gothic New", sans-serif;
		line-height: 1.8;
		color: #333;
		background-color: #ffffff;
		background-image:
		linear-gradient(#e1e1e1 1px, transparent 1px),
		linear-gradient(90deg, #e1e1e1 1px, transparent 1px);  
		background-size: 32px 32px;
		position: relative;
	}

	/* 背景にシール */
    .sticker.bg-sticker {
        z-index: -1 !important;    /* カードやテキストの後ろに配置 */
    }

	header, main, footer {
        position: relative;
        z-index: 10; 
    }

    /* シールの共通見た目 */
    .sticker {
        position: absolute;
        width: 250px;
		height: auto;
        user-select: none;
        pointer-events: none;
		z-index: 20;
        animation: stickerPop 0.15s ease-out forwards;
        filter: drop-shadow(2px 3px 2px rgba(0,0,0,0.15)); /* シールっぽい影 */
    }

	/* シールを全画面に配置する透明なエリア */
    #stickerContainer {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none; /* クリックを通過させて下のボタンを押せるようにする */
    }

	nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-bottom: 1rem;
		border-bottom: 1.5px solid #ff007f;
	}

	.site-logo {
		font-size: 1.4rem;
		font-weight: bold;
		color: #ff007f;
		text-decoration: none;
		font-family: "Dela Gothic One", sans-serif;
	}

	.nav-links {
		display: flex;
		gap: 1.5rem;
	}

	.nav-links a {
		color: #ff007f;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.nav-links a:hover {
		opacity: 0.7;
	}

	main {
		background-color: #fff;
		border-radius: 12px;
		box-shadow: 0 2px 16px rgba(0, 0, 0, 0.08);
		padding: 2rem;
		margin-top: 1.5rem;
	}

	footer {
		margin-top: 2rem;
		padding-top: 1rem;
		font-size: 0.85rem;
		text-align: center;
		color: #202020;
	}

    /* 貼られた瞬間のポンッとなるアニメーション */
    @keyframes stickerPop {
        0% {
            opacity: 0;
            transform: translate(-50%, -50%) scale(1.6);
        }
        100% {
            opacity: 1;
        }
    }

	/* シール消去ボタンの見た目 */

	.clear-btn {
		display: block;
		margin: 1.5rem auto 0;
		padding: 0.5rem 1.2rem;
		font-size: 0.85rem;
		font-weight: bold;
		color: #ff007f;
		background-color: #ffffff;
		border: 2px solid #ff007f;
		border-radius: 20px;
		cursor: pointer;
		transition: all 0.2s ease;
		position: relative;
		z-index: 100; /* シールより上に表示して押しやすくする */
	}

	.clear-btn:hover {
		background-color: #ff007f;
		color: #ffffff;
		transform: scale(1.05);
	}

	/* フェードアウトアニメーションの定義 */
	@keyframes stickerFadeOut {
		0% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}

	.sticker.is-fading {
		animation: stickerFadeOut 0.3s ease-out forwards !important;
	}

	html, body {
		touch-action: manipulation; /* ダブルタップで拡大防止 */
	}

	/* スマホ画面用の調整 */
	@media (max-width: 768px) {
		.sticker {
			width: 140px; /* スマホだと250pxは大きいので少し小さく */
		}
	}
</style>